rules_version = '2';

// Organization project storage. The only file is each organization's logo: one
// square 512 px PNG, converted on an administrator's device (any input format), so
// an SVG (and its scripts) is never stored or served.
service firebase.storage {
  match /b/{bucket}/o {

    /// The caller's key in Firestore: the lowercase-hex SHA-256 of the
    /// lowercased e-mail, as in firestore.rules.
    function personKey() {
      return hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
    }

    /// The caller administers [organizationId]: their
    /// organizationMemberships document has `role: 'admin'`. Reads one
    /// document of the default database (Storage may read Firestore once the
    /// project grants it, on the first deploy of these rules).
    function isOrganizationAdmin(organizationId) {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/organizations/$(organizationId)/organizationMemberships/$(personKey())).data.role == 'admin';
    }

    match /organizations/{organizationId}/logo.png {
      // Public, like config/branding: the organization picker shows it
      // before signing in to this project.
      allow read: if true;

      // Only the organization's administrators, only a PNG of at most 1 MB.
      allow write: if isOrganizationAdmin(organizationId)
        && (request.resource == null
          || (request.resource.contentType == 'image/png'
            && request.resource.size <= 1024 * 1024));
    }
  }
}
