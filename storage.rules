rules_version = '2';

// Partner project storage. The only file is each partner's logo: one
// square 512 px PNG, converted on an administrator's device (any input format), so
// an SVG (and its scripts) is never stored or served.
service firebase.storage {
  match /b/{bucket}/o {

    /// The caller's key in Firestore (#159): the lowercase-hex SHA-256 of
    /// the lowercased e-mail, as in firestore.rules.
    function personKey() {
      return hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
    }

    /// The caller administers [partnerId] in Firestore (#159). Reads one
    /// document of the default database.
    function isOrganizationAdmin(partnerId) {
      return request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/partners/$(partnerId)/organizationMemberships/$(personKey())).data.role == 'admin';
    }

    match /partners/{partnerId}/logo.png {
      // Public, like config/branding: the organization picker shows it
      // before signing in to this project.
      allow read: if true;

      // Only the partner's administrators (members of its root group, or,
      // after the migration, an `admin` membership in Firestore), only a
      // PNG of at most 1 MB.
      allow write: if request.auth != null
        && (('admin' in request.auth.token
            && request.auth.token.admin is list
            && request.auth.token.admin.hasAny([partnerId]))
          || isOrganizationAdmin(partnerId))
        && (request.resource == null
          || (request.resource.contentType == 'image/png'
            && request.resource.size <= 1024 * 1024));
    }
  }
}
