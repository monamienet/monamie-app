rules_version = '2';

// Organization project rules. Every organization's data lives under
// organizations/{organizationId}, the same layout for a Standard project
// (one organization) and the shared Community project (many organizations),
// so no rule depends on the plan except the location interval below.
//
// What a person may do comes from membership documents in this project,
// written only by the central functions (central/functions/) and
// `tool/organization.dart add-admin`, never by a client:
//   organizations/{id}/organizationMemberships/{personKey}
//       {email, role: 'admin' | 'member', addedAt}: who belongs; an
//       administrator manages the organization and sees every group
//   organizations/{id}/groups/{groupId}/groupMemberships/{personKey}
//       {email, organizationId, roles, addedAt}: roles in a group,
//       'publisher' (shares their own location there), 'subscriber' (sees
//       the group's map) and 'maintainer' (#165, grants nothing extra yet)
// personKey() is the lowercase-hex SHA-256 of the lowercased e-mail, so no
// e-mail appears in a document name; each document also stores `email`.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    /// The caller's key. Call only after isVerified().
    function personKey() {
      return hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
    }

    // "Which groups am I in?": a collection-group query on the person's own
    // memberships, filtered by `email` (and `organizationId`).
    match /{path=**}/groupMemberships/{key} {
      allow read: if isVerified() && resource.data.email == request.auth.token.email;
    }

    match /organizations/{organizationId} {

      function organizationMembership() {
        return get(/databases/$(database)/documents/organizations/$(organizationId)/organizationMemberships/$(personKey()));
      }

      /// The caller belongs to this organization in Firestore.
      function isOrganizationMember() {
        return isVerified() && organizationMembership() != null;
      }

      /// The caller administers this organization in Firestore.
      function isOrganizationAdmin() {
        return isVerified() && organizationMembership() != null
          && organizationMembership().data.role == 'admin';
      }

      function groupMembership(groupId) {
        return get(/databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/groupMemberships/$(personKey()));
      }

      /// The caller has a membership (any role) in group [groupId].
      function isInGroup(groupId) {
        return isVerified() && groupMembership(groupId) != null;
      }

      /// The caller holds [role] in group [groupId].
      function hasGroupRole(groupId, role) {
        return isVerified() && groupMembership(groupId) != null
          && role in groupMembership(groupId).data.roles;
      }

      /// The caller receives the positions published in [groupId]. The
      /// group membership is checked first, so a subscriber costs one read.
      function canSubscribe(groupId) {
        return hasGroupRole(groupId, 'subscriber') || isOrganizationAdmin();
      }

      /// A new position carries `receivedAt` = the server's time, at least
      /// the plan's interval after the previous one. Heartbeats and other
      /// updates leave `receivedAt` alone.
      function publishTimingOk() {
        return positionChanged()
          ? request.resource.data.get('receivedAt', null) == request.time
            && (resource == null
              || resource.data.get('receivedAt', null) == null
              || request.time > resource.data.receivedAt
                   + duration.value(minIntervalMinutes(), 'm'))
          : request.resource.data.get('receivedAt', null)
              == (resource == null ? null : resource.data.get('receivedAt', null));
      }

      /// The position in [groupId] after the current batch: trail points
      /// and day summaries are written in the same batch as it.
      function publishedNow(groupId, key) {
        return getAfter(/databases/$(database)/documents/organizations/$(organizationId)/groups/$(groupId)/positions/$(key)).data.receivedAt == request.time;
      }

      // ── organizationMemberships/{key}: who belongs, with role ─────────
      // Fields: email, role ('admin' or 'member'), addedAt.
      match /organizationMemberships/{key} {
        // Your own, even when it does not exist (the app learns it was
        // removed), or any of them as an administrator.
        allow get: if isVerified() && (key == personKey() || isOrganizationAdmin());
        allow list: if isOrganizationAdmin();
        allow write: if false;
      }

      // ── groups/{groupId}: a group of this organization ────────────────
      // Fields: name, createdAt. Auto ids, never reused.
      match /groups/{groupId} {
        // Administrators list them all; a person reads the groups they
        // belong to (any role).
        allow get: if isOrganizationAdmin() || isInGroup(groupId);
        allow list: if isOrganizationAdmin();
        allow write: if false;

        // Fields: email, organizationId, roles ('maintainer', 'publisher',
        // 'subscriber'). The collection-group rule above adds your own.
        match /groupMemberships/{key} {
          allow read: if isOrganizationAdmin();
          allow write: if false;
        }

        // ── positions/{key}: the person's last position in this group ──
        // Fields: email, name, lat, lng, capturedAt (device clock),
        // receivedAt (server clock), isPublishing, removedAt (set by the
        // central functions when the person stops publishing here).
        match /positions/{key} {
          allow get: if isVerified() && (key == personKey() || canSubscribe(groupId));
          allow list: if canSubscribe(groupId);

          allow create, update: if isVerified()
            && key == personKey()
            && hasGroupRole(groupId, 'publisher')
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.keys().hasOnly(
                 ['email', 'name', 'lat', 'lng', 'capturedAt', 'receivedAt',
                  'isPublishing', 'removedAt'])
            && request.resource.data.get('removedAt', null) == null
            && publishTimingOk();

          allow delete: if false;

          // ── trail/{pointId}: one point per position published ────────
          match /trail/{pointId} {
            allow read: if isVerified() && (key == personKey() || canSubscribe(groupId));

            allow create: if isVerified()
              && key == personKey()
              && hasGroupRole(groupId, 'publisher')
              && request.resource.data.keys().hasOnly(['lat', 'lng', 'receivedAt'])
              && request.resource.data.lat is number
              && request.resource.data.lng is number
              && request.resource.data.receivedAt == request.time
              && publishedNow(groupId, key);

            allow update, delete: if false;
          }

          // ── trailDays/{yyyy-mm-dd}: one summary per day, for the calendar
          match /trailDays/{day} {
            allow read: if isVerified() && (key == personKey() || canSubscribe(groupId));

            allow create, update: if isVerified()
              && key == personKey()
              && hasGroupRole(groupId, 'publisher')
              && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.keys().hasOnly(['lastAt', 'pointCount'])
              && request.resource.data.lastAt == request.time
              && request.resource.data.pointCount is int
              && publishedNow(groupId, key);

            allow delete: if false;
          }
        }
      }

      /// Minimum minutes between two positions: the plan's limit on
      /// Community (config/plan, written only by MonAmieNet), none on
      /// Standard. Enforced here because hiding presets in the app would
      /// not stop a modified app.
      function minIntervalMinutes() {
        let plan = /databases/$(database)/documents/organizations/$(organizationId)/config/plan;
        return exists(plan) ? get(plan).data.minIntervalMinutes : 0;
      }

      /// Whether the write sets or moves the position. Creating the
      /// document without coordinates (at sign-in) is not a position.
      function positionChanged() {
        return resource == null
          ? 'lat' in request.resource.data || 'lng' in request.resource.data
          : request.resource.data.get('lat', null) != resource.data.get('lat', null)
            || request.resource.data.get('lng', null) != resource.data.get('lng', null);
      }

      // ── config/branding: the organization's name and look ───────────────────
      // Public: the app shows the brand in the organization picker and
      // while entering, before signing in to this project.
      match /config/branding {
        allow read: if true;
        allow write: if false;
      }

      // ── config/tracking: how often people in the field send positions ──
      // Fields: intervalMinutes, distanceMeters, updatedAt, updatedBy.
      // Members read it (the background service applies it); only an
      // administrator writes it, with the values the app offers and never
      // below the plan's minimum interval.
      match /config/tracking {
        allow read: if isOrganizationMember();
        allow write: if isOrganizationAdmin()
          && request.resource.data.keys().hasOnly(
               ['intervalMinutes', 'distanceMeters', 'updatedAt', 'updatedBy'])
          && request.resource.data.intervalMinutes in [1, 2, 3, 5, 10, 15, 20, 30]
          && request.resource.data.distanceMeters in [5, 10, 20, 50, 100, 200, 300, 500]
          && request.resource.data.intervalMinutes >= minIntervalMinutes()
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.token.email;
      }

      // ── config/plan: the plan's limits (Community: minIntervalMinutes) ─
      match /config/plan {
        allow read: if isOrganizationMember();
        allow write: if false;
      }
    }

    // Everything else is denied: Firestore denies by default.
  }
}
