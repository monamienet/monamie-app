rules_version = '2';

// Partner project rules. Every partner's data lives under
// partners/{partnerId}, the same layout for a Standard project (one
// partner) and the shared Community project (many partners), so no rule
// depends on the plan except the location interval below.
//
// What a person may do comes from the custom claims set by `syncClaims`
// (functions/index.js) from *which* Google Groups they are in:
//   share:    ["rotasul01"]  team keys where they share their own location
//                            (member of rotasul01w@monamienet.org)
//   watch:    ["rotasul01"]  team keys whose map they see
//                            (member of rotasul01r@monamienet.org)
//   owns:     ["rotasul"]    partners they own (member of rotasul00@), which
//                            means watching every team of that partner
//   partners: ["rotasul"]    partners where they have any of the above
// A team key is the local part of the team group, `<partner id><NN>`.
// Location documents name their team by the team group's e-mail
// (`grupo_ativo`, e.g. "rotasul01@monamienet.org").
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    function claimList(name) {
      return isAuthenticated() && name in request.auth.token
        && request.auth.token[name] is list
        ? request.auth.token[name]
        : [];
    }

    /// `rotasul01@monamienet.org` → `rotasul01`.
    function teamKeyOf(groupEmail) {
      return groupEmail.lower().split('@')[0];
    }

    function isDocOwner(docEmail) {
      return isAuthenticated() && request.auth.token.email == docEmail;
    }

    match /partners/{partnerId} {

      /// The caller has some capability in this partner.
      function isMember() {
        return claimList('partners').hasAny([partnerId]);
      }

      /// [groupEmail] is a team of this partner (never another's).
      function isTeamHere(groupEmail) {
        return groupEmail is string
          && teamKeyOf(groupEmail).matches(partnerId + '[0-9]{2}');
      }

      /// The caller shares their location in this team.
      function canShareIn(groupEmail) {
        return isTeamHere(groupEmail)
          && claimList('share').hasAny([teamKeyOf(groupEmail)]);
      }

      /// The caller sees this team's map: they watch it, or own the partner.
      function canWatch(groupEmail) {
        return isTeamHere(groupEmail)
          && (claimList('watch').hasAny([teamKeyOf(groupEmail)])
            || claimList('owns').hasAny([partnerId]));
      }

      /// Minimum minutes between two positions: the plan's limit on
      /// Community (config/plan, written only by MonAmieNet), none on
      /// Standard. Enforced here because hiding presets in the app would
      /// not stop a modified app.
      function minIntervalMinutes() {
        let plan = /databases/$(database)/documents/partners/$(partnerId)/config/plan;
        return exists(plan) ? get(plan).data.minIntervalMinutes : 0;
      }

      /// Whether the write sets or moves the position. Creating the
      /// document without coordinates (at sign-in) is not a position.
      function positionChanged() {
        return resource == null
          ? 'lat' in request.resource.data || 'lng' in request.resource.data
          : request.resource.data.get('lat', null) != resource.data.get('lat', null)
            || request.resource.data.get('lng', null) != resource.data.get('lng', null);
      }

      /// A new position must carry `positionAt` = the server's time, at
      /// least the plan's interval after the previous one. Heartbeats and
      /// other updates leave `positionAt` alone.
      function positionTimingOk() {
        return positionChanged()
          ? request.resource.data.get('positionAt', null) == request.time
            && (resource == null
              || resource.data.get('positionAt', null) == null
              || request.time > resource.data.positionAt
                   + duration.value(minIntervalMinutes(), 'm'))
          : request.resource.data.get('positionAt', null)
              == (resource == null ? null : resource.data.get('positionAt', null));
      }

      // ── usuarios/{email}: the live position of a person in the field ──
      // Fields: email, nome, lat, lng, timestamp, positionAt, isTracked,
      // grupo_ativo (the team they share with)
      match /usuarios/{usuarioEmail} {

        // Their own document (as a member of this partner), or the people
        // who watch the team it is shared with. A field-only person reads
        // only their own.
        allow read: if (isMember() && isDocOwner(usuarioEmail))
          || canWatch(resource.data.grupo_ativo);

        // Only members who share somewhere write, only their own document,
        // and only towards a team of this partner where they share.
        allow create, update: if isMember()
          && claimList('share').size() > 0
          && isDocOwner(usuarioEmail)
          && request.resource.data.email == request.auth.token.email
          && (resource == null || request.resource.data.email == resource.data.email)
          && request.resource.data.keys().hasOnly(
               ['email', 'nome', 'lat', 'lng', 'timestamp', 'positionAt',
                'isTracked', 'grupo_ativo']
             )
          && (
            !('grupo_ativo' in request.resource.data)
            || request.resource.data.grupo_ativo == null
            || canShareIn(request.resource.data.grupo_ativo)
          )
          && positionTimingOk();

        // Location data is kept.
        allow delete: if false;

        // ── historico_posicoes/{pontoId}: append-only trail points ──────
        // Fields: lat, lng, timestamp, grupo_ativo
        match /historico_posicoes/{pontoId} {

          // Read by the owner, or by whoever watches the team the person
          // currently shares with (a rule that does not depend on each
          // point, so a time-range query over the trail is allowed).
          allow read: if (isMember() && isDocOwner(usuarioEmail))
            || canWatch(
                 get(/databases/$(database)/documents/partners/$(partnerId)/usuarios/$(usuarioEmail)).data.grupo_ativo
               );

          // A point is written in the same batch as the position update it
          // records, so the interval above also limits the trail.
          allow create: if isMember()
            && isDocOwner(usuarioEmail)
            && request.resource.data.keys().hasOnly(['lat', 'lng', 'timestamp', 'grupo_ativo'])
            && request.resource.data.lat is number
            && request.resource.data.lng is number
            && request.resource.data.timestamp == request.time
            && getAfter(/databases/$(database)/documents/partners/$(partnerId)/usuarios/$(usuarioEmail)).data.positionAt == request.time
            && (
              !('grupo_ativo' in request.resource.data)
              || request.resource.data.grupo_ativo == null
              || canShareIn(request.resource.data.grupo_ativo)
            );

          allow update, delete: if false;
        }
      }

      // ── users/{uid}: the Google profile written at sign-in ─────────────
      // Fields: name, email, urlImage, createdAt, avatarBase64
      match /users/{userId} {

        // Names and avatars of the people on the map, for this partner's
        // members only.
        allow read: if isMember();

        allow create, update: if isMember()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(
               ['name', 'email', 'urlImage', 'createdAt', 'avatarBase64']
             );

        allow delete: if false;
      }

      // ── config/branding: the partner's name and look ───────────────────
      // Public: the app shows the brand in the organization picker and
      // while entering, before signing in to this project.
      match /config/branding {
        allow read: if true;
        allow write: if false;
      }

      // ── config/plan: the plan's limits (Community: minIntervalMinutes) ─
      match /config/plan {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // Everything else is denied: Firestore denies by default.
  }
}
