rules_version = '2';

// Partner project rules. Every partner's data lives under
// partners/{partnerId}, the same layout for a Standard project (one
// partner) and the shared Community project (many partners), so no rule
// depends on the plan except the location interval below.
//
// What a person may do comes from the custom claims set by `syncClaims`
// (functions/index.js) from *which* Google Groups they are in:
//   share:    ["rotasul01"]  team keys where they share their own location
//                            (member of rotasul01w@monamienet.org)
//   watch:    ["rotasul01"]  team keys whose map they see
//                            (member of rotasul01r@monamienet.org)
//   admin:    ["rotasul"]    partners they administer (member of rotasul00@),
//                            which means watching every team of that partner
//   partners: ["rotasul"]    partners where they have any of the above
// A team key is the local part of the team group, `<partner id><NN>`.
// Location documents name their team by the team group's e-mail
// (`grupo_ativo`, e.g. "rotasul01@monamienet.org").
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    function claimList(name) {
      return isAuthenticated() && name in request.auth.token
        && request.auth.token[name] is list
        ? request.auth.token[name]
        : [];
    }

    /// `rotasul01@monamienet.org` → `rotasul01`.
    function teamKeyOf(groupEmail) {
      return groupEmail.lower().split('@')[0];
    }

    function isDocOwner(docEmail) {
      return isAuthenticated() && request.auth.token.email == docEmail;
    }

    // ── Memberships in Firestore (#159, phase 1 of the migration) ────────
    // The documents below replace Google Groups and the claims above. No
    // client uses them yet. They are keyed by personKey(): the
    // lowercase-hex SHA-256 of the lowercased e-mail, so no e-mail appears
    // in a document name. Each one also stores the `email` field.

    function isVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    /// The caller's key. Call only after isVerified().
    function personKey() {
      return hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
    }

    // "Which groups am I in?": a collection-group query on the person's own
    // memberships, filtered by `email` (and `organizationId`).
    match /{path=**}/groupMemberships/{key} {
      allow read: if isVerified() && resource.data.email == request.auth.token.email;
    }

    match /partners/{partnerId} {

      function organizationMembership() {
        return get(/databases/$(database)/documents/partners/$(partnerId)/organizationMemberships/$(personKey()));
      }

      /// The caller belongs to this organization in Firestore.
      function isOrganizationMember() {
        return isVerified() && organizationMembership() != null;
      }

      /// The caller administers this organization in Firestore.
      function isOrganizationAdmin() {
        return isVerified() && organizationMembership() != null
          && organizationMembership().data.role == 'admin';
      }

      /// The caller holds [role] in group [groupId].
      function hasGroupRole(groupId, role) {
        let membership = get(/databases/$(database)/documents/partners/$(partnerId)/groups/$(groupId)/groupMemberships/$(personKey()));
        return isVerified() && membership != null && role in membership.data.roles;
      }

      /// The caller receives the positions published in [groupId]. The
      /// group membership is checked first, so a subscriber costs one read.
      function canSubscribe(groupId) {
        return hasGroupRole(groupId, 'subscriber') || isOrganizationAdmin();
      }

      /// Like positionTimingOk(), for the new positions: a new position
      /// carries `receivedAt` = the server's time, at least the plan's
      /// interval after the previous one.
      function publishTimingOk() {
        return positionChanged()
          ? request.resource.data.get('receivedAt', null) == request.time
            && (resource == null
              || resource.data.get('receivedAt', null) == null
              || request.time > resource.data.receivedAt
                   + duration.value(minIntervalMinutes(), 'm'))
          : request.resource.data.get('receivedAt', null)
              == (resource == null ? null : resource.data.get('receivedAt', null));
      }

      /// The position in [groupId] after the current batch: trail points
      /// and day summaries are written in the same batch as it.
      function publishedNow(groupId, key) {
        return getAfter(/databases/$(database)/documents/partners/$(partnerId)/groups/$(groupId)/positions/$(key)).data.receivedAt == request.time;
      }

      // ── organizationMemberships/{key}: who belongs, with role ─────────
      // Fields: email, role ('admin' or 'member'), addedAt.
      match /organizationMemberships/{key} {
        // Your own, even when it does not exist (the app learns it was
        // removed), or any of them as an administrator.
        allow get: if isVerified() && (key == personKey() || isOrganizationAdmin());
        allow list: if isOrganizationAdmin();
        allow write: if false;
      }

      // ── groups/{groupId}: a group of this organization ────────────────
      // Fields: name, createdAt. Auto ids, never reused.
      match /groups/{groupId} {
        allow read: if isOrganizationMember();
        allow write: if false;

        // Fields: email, organizationId, roles ('maintainer', 'publisher',
        // 'subscriber'). The collection-group rule above adds your own.
        match /groupMemberships/{key} {
          allow read: if isOrganizationAdmin();
          allow write: if false;
        }

        // ── positions/{key}: the person's last position in this group ──
        // Fields: email, name, lat, lng, capturedAt (device clock),
        // receivedAt (server clock), isPublishing, removedAt (set by the
        // central functions when the person stops publishing here).
        match /positions/{key} {
          allow get: if isVerified() && (key == personKey() || canSubscribe(groupId));
          allow list: if canSubscribe(groupId);

          allow create, update: if isVerified()
            && key == personKey()
            && hasGroupRole(groupId, 'publisher')
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.keys().hasOnly(
                 ['email', 'name', 'lat', 'lng', 'capturedAt', 'receivedAt',
                  'isPublishing', 'removedAt'])
            && request.resource.data.get('removedAt', null) == null
            && publishTimingOk();

          allow delete: if false;

          // ── trail/{pointId}: one point per position published ────────
          match /trail/{pointId} {
            allow read: if isVerified() && (key == personKey() || canSubscribe(groupId));

            allow create: if isVerified()
              && key == personKey()
              && hasGroupRole(groupId, 'publisher')
              && request.resource.data.keys().hasOnly(['lat', 'lng', 'receivedAt'])
              && request.resource.data.lat is number
              && request.resource.data.lng is number
              && request.resource.data.receivedAt == request.time
              && publishedNow(groupId, key);

            allow update, delete: if false;
          }

          // ── trailDays/{yyyy-mm-dd}: one summary per day, for the calendar
          match /trailDays/{day} {
            allow read: if isVerified() && (key == personKey() || canSubscribe(groupId));

            allow create, update: if isVerified()
              && key == personKey()
              && hasGroupRole(groupId, 'publisher')
              && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              && request.resource.data.keys().hasOnly(['lastAt', 'pointCount'])
              && request.resource.data.lastAt == request.time
              && request.resource.data.pointCount is int
              && publishedNow(groupId, key);

            allow delete: if false;
          }
        }
      }

      /// The caller has some capability in this partner.
      function isMember() {
        return claimList('partners').hasAny([partnerId]);
      }

      /// [groupEmail] is a team of this partner (never another's).
      function isTeamHere(groupEmail) {
        return groupEmail is string
          && teamKeyOf(groupEmail).matches(partnerId + '[0-9]{2}');
      }

      /// The caller shares their location in this team.
      function canShareIn(groupEmail) {
        return isTeamHere(groupEmail)
          && claimList('share').hasAny([teamKeyOf(groupEmail)]);
      }

      /// The caller sees this team's map: they watch it, or administer the
      /// partner.
      function canWatch(groupEmail) {
        return isTeamHere(groupEmail)
          && (claimList('watch').hasAny([teamKeyOf(groupEmail)])
            || claimList('admin').hasAny([partnerId]));
      }

      /// Minimum minutes between two positions: the plan's limit on
      /// Community (config/plan, written only by MonAmieNet), none on
      /// Standard. Enforced here because hiding presets in the app would
      /// not stop a modified app.
      function minIntervalMinutes() {
        let plan = /databases/$(database)/documents/partners/$(partnerId)/config/plan;
        return exists(plan) ? get(plan).data.minIntervalMinutes : 0;
      }

      /// Whether the write sets or moves the position. Creating the
      /// document without coordinates (at sign-in) is not a position.
      function positionChanged() {
        return resource == null
          ? 'lat' in request.resource.data || 'lng' in request.resource.data
          : request.resource.data.get('lat', null) != resource.data.get('lat', null)
            || request.resource.data.get('lng', null) != resource.data.get('lng', null);
      }

      /// A new position must carry `positionAt` = the server's time, at
      /// least the plan's interval after the previous one. Heartbeats and
      /// other updates leave `positionAt` alone.
      function positionTimingOk() {
        return positionChanged()
          ? request.resource.data.get('positionAt', null) == request.time
            && (resource == null
              || resource.data.get('positionAt', null) == null
              || request.time > resource.data.positionAt
                   + duration.value(minIntervalMinutes(), 'm'))
          : request.resource.data.get('positionAt', null)
              == (resource == null ? null : resource.data.get('positionAt', null));
      }

      // ── usuarios/{email}: the live position of a person in the field ──
      // Fields: email, nome, lat, lng, timestamp, positionAt, isTracked,
      // grupo_ativo (the team they share with)
      match /usuarios/{usuarioEmail} {

        // Their own document (as a member of this partner), or the people
        // who watch the team it is shared with. A field-only person reads
        // only their own.
        allow read: if (isMember() && isDocOwner(usuarioEmail))
          || canWatch(resource.data.grupo_ativo);

        // Only members who share somewhere write, only their own document,
        // and only towards a team of this partner where they share.
        allow create, update: if isMember()
          && claimList('share').size() > 0
          && isDocOwner(usuarioEmail)
          && request.resource.data.email == request.auth.token.email
          && (resource == null || request.resource.data.email == resource.data.email)
          && request.resource.data.keys().hasOnly(
               ['email', 'nome', 'lat', 'lng', 'timestamp', 'positionAt',
                'isTracked', 'grupo_ativo']
             )
          && (
            !('grupo_ativo' in request.resource.data)
            || request.resource.data.grupo_ativo == null
            || canShareIn(request.resource.data.grupo_ativo)
          )
          && positionTimingOk();

        // Location data is kept.
        allow delete: if false;

        // ── dias/{yyyy-mm-dd}: one summary per day with trails ──────────
        // Fields: lastAt, points, grupo_ativo. Written in the same batch as
        // a position, so it follows the same interval; read like the trail.
        // The history calendar reads a month of these, not every point.
        match /dias/{day} {
          allow read: if (isMember() && isDocOwner(usuarioEmail))
            || canWatch(
                 get(/databases/$(database)/documents/partners/$(partnerId)/usuarios/$(usuarioEmail)).data.grupo_ativo
               );

          allow create, update: if isMember()
            && claimList('share').size() > 0
            && isDocOwner(usuarioEmail)
            && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && request.resource.data.keys().hasOnly(['lastAt', 'points', 'grupo_ativo'])
            && request.resource.data.lastAt == request.time
            && request.resource.data.points is int
            && getAfter(/databases/$(database)/documents/partners/$(partnerId)/usuarios/$(usuarioEmail)).data.positionAt == request.time
            && (
              !('grupo_ativo' in request.resource.data)
              || request.resource.data.grupo_ativo == null
              || canShareIn(request.resource.data.grupo_ativo)
            );

          allow delete: if false;
        }

        // ── historico_posicoes/{pontoId}: append-only trail points ──────
        // Fields: lat, lng, timestamp, grupo_ativo
        match /historico_posicoes/{pontoId} {

          // Read by the owner, or by whoever watches the team the person
          // currently shares with (a rule that does not depend on each
          // point, so a time-range query over the trail is allowed).
          allow read: if (isMember() && isDocOwner(usuarioEmail))
            || canWatch(
                 get(/databases/$(database)/documents/partners/$(partnerId)/usuarios/$(usuarioEmail)).data.grupo_ativo
               );

          // A point is written in the same batch as the position update it
          // records, so the interval above also limits the trail.
          allow create: if isMember()
            && isDocOwner(usuarioEmail)
            && request.resource.data.keys().hasOnly(['lat', 'lng', 'timestamp', 'grupo_ativo'])
            && request.resource.data.lat is number
            && request.resource.data.lng is number
            && request.resource.data.timestamp == request.time
            && getAfter(/databases/$(database)/documents/partners/$(partnerId)/usuarios/$(usuarioEmail)).data.positionAt == request.time
            && (
              !('grupo_ativo' in request.resource.data)
              || request.resource.data.grupo_ativo == null
              || canShareIn(request.resource.data.grupo_ativo)
            );

          allow update, delete: if false;
        }
      }

      // ── users/{uid}: the Google profile written at sign-in ─────────────
      // Fields: name, email, urlImage, createdAt, avatarBase64
      match /users/{userId} {

        // Names and avatars of the people on the map, for this partner's
        // members only.
        allow read: if isMember();

        allow create, update: if isMember()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(
               ['name', 'email', 'urlImage', 'createdAt', 'avatarBase64']
             );

        allow delete: if false;
      }

      // ── config/branding: the partner's name and look ───────────────────
      // Public: the app shows the brand in the organization picker and
      // while entering, before signing in to this project.
      match /config/branding {
        allow read: if true;
        allow write: if false;
      }

      // ── config/tracking: how often people in the field send positions ──
      // Fields: intervalMinutes, distanceMeters, updatedAt, updatedBy.
      // Members read it (the background service applies it); only an
      // administrator writes it, with the values the app offers and never
      // below the plan's minimum interval.
      match /config/tracking {
        allow read: if isMember();
        allow write: if claimList('admin').hasAny([partnerId])
          && request.resource.data.keys().hasOnly(
               ['intervalMinutes', 'distanceMeters', 'updatedAt', 'updatedBy'])
          && request.resource.data.intervalMinutes in [1, 2, 3, 5, 10, 15, 20, 30]
          && request.resource.data.distanceMeters in [5, 10, 20, 50, 100, 200, 300, 500]
          && request.resource.data.intervalMinutes >= minIntervalMinutes()
          && request.resource.data.updatedAt == request.time
          && request.resource.data.updatedBy == request.auth.token.email;
      }

      // ── config/plan: the plan's limits (Community: minIntervalMinutes) ─
      match /config/plan {
        allow read: if isMember();
        allow write: if false;
      }
    }

    // Everything else is denied: Firestore denies by default.
  }
}
