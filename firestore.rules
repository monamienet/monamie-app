rules_version = '2';

// Partner project rules.
//
// What a person may do comes from the custom claims set by `syncClaims`
// (functions/index.js) from *which* Google Groups they are in:
//   share: ["rotasul01"]  team keys where they share their own location
//                         (member of rotasul01w@monamienet.org)
//   watch: ["rotasul01"]  team keys whose map they see
//                         (member of rotasul01r@monamienet.org)
//   owns:  ["rotasul"]    partners they own (member of rotasul00@), which
//                         means watching every team of that partner
// A team key is the local part of the team group, `<partner id><NN>`.
// Location documents name their team by the team group's e-mail
// (`grupo_ativo`, e.g. "rotasul01@monamienet.org").
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    function claimList(name) {
      return isAuthenticated() && name in request.auth.token
        && request.auth.token[name] is list
        ? request.auth.token[name]
        : [];
    }

    /// `rotasul01@monamienet.org` → `rotasul01`.
    function teamKeyOf(groupEmail) {
      return groupEmail.lower().split('@')[0];
    }

    /// `rotasul01` → `rotasul`: partner ids are letters only.
    function partnerOfTeam(teamKey) {
      return teamKey.split('[0-9]{2}$')[0];
    }

    /// The caller shares their location in this team.
    function canShareIn(groupEmail) {
      return groupEmail is string
        && claimList('share').hasAny([teamKeyOf(groupEmail)]);
    }

    /// The caller sees this team's map: they watch it, or own its partner.
    function canWatch(groupEmail) {
      return groupEmail is string
        && (claimList('watch').hasAny([teamKeyOf(groupEmail)])
          || claimList('owns').hasAny([partnerOfTeam(teamKeyOf(groupEmail))]));
    }

    /// The caller shares in at least one team.
    function sharesAnywhere() {
      return claimList('share').size() > 0;
    }

    function isDocOwner(docEmail) {
      return isAuthenticated() && request.auth.token.email == docEmail;
    }

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  usuarios/{email}: the live position of a person in the field   ║
    // ║  Fields: email, nome, lat, lng, timestamp, isTracked,           ║
    // ║  grupo_ativo (the team they share with)                         ║
    // ╚══════════════════════════════════════════════════════════════════╝
    match /usuarios/{usuarioEmail} {

      // Their own document, or the people who watch the team it is
      // shared with. A field-only person reads only their own.
      allow read: if isDocOwner(usuarioEmail)
        || canWatch(resource.data.grupo_ativo);

      // Only people who share somewhere write, only their own document,
      // and only towards a team where they share.
      allow create, update: if sharesAnywhere()
        && isDocOwner(usuarioEmail)
        && request.resource.data.email == request.auth.token.email
        && (resource == null || request.resource.data.email == resource.data.email)
        && request.resource.data.keys().hasOnly(
             ['email', 'nome', 'lat', 'lng', 'timestamp', 'isTracked', 'grupo_ativo']
           )
        && (
          !('grupo_ativo' in request.resource.data)
          || request.resource.data.grupo_ativo == null
          || canShareIn(request.resource.data.grupo_ativo)
        );

      // Location data is kept.
      allow delete: if false;

      // ── historico_posicoes/{pontoId}: append-only trail points ────────
      // Fields: lat, lng, timestamp, grupo_ativo
      match /historico_posicoes/{pontoId} {

        // Read by the owner, or by whoever watches the team the person
        // currently shares with (a rule that does not depend on each
        // point, so a time-range query over the trail is allowed).
        allow read: if isDocOwner(usuarioEmail)
          || canWatch(
               get(/databases/$(database)/documents/usuarios/$(usuarioEmail)).data.grupo_ativo
             );

        allow create: if sharesAnywhere()
          && isDocOwner(usuarioEmail)
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'timestamp', 'grupo_ativo'])
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.timestamp is timestamp
          && (
            !('grupo_ativo' in request.resource.data)
            || request.resource.data.grupo_ativo == null
            || canShareIn(request.resource.data.grupo_ativo)
          );

        allow update, delete: if false;
      }
    }

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  users/{uid}: the Google profile written at sign-in             ║
    // ║  Fields: name, email, urlImage, createdAt, avatarBase64         ║
    // ╚══════════════════════════════════════════════════════════════════╝
    match /users/{userId} {

      // Names and avatars of the people on the map.
      allow read: if isAuthenticated();

      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'urlImage', 'createdAt', 'avatarBase64']
           );

      allow delete: if false;
    }

    // ╔══════════════════════════════════════════════════════════════════╗
    // ║  config/branding: the partner's name and look                   ║
    // ╚══════════════════════════════════════════════════════════════════╝
    // Public: the app shows the brand in the organization picker and while
    // entering, before signing in to this project. Written only with
    // maintainer credentials (`tool/partner.dart publish`).
    match /config/branding {
      allow read: if true;
      allow write: if false;
    }

    // Everything else is denied: Firestore denies by default.
  }
}
