rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  FUNÇÕES AUXILIARES                                                 ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    /// Autenticado com email disponível.
    function isAuthenticated() {
      return request.auth != null
        && request.auth.token.email != null;
    }

    /// AUTORIZADO: tem role em pelo menos um grupo MonAmie.
    /// Isto é: o mapa group_roles existe e não é vazio.
    /// Cobre: participantes, administradores, proprietários e metausuários.
    function isAutorizado() {
      return isAuthenticated()
        && request.auth.token.group_roles is map
        && request.auth.token.group_roles.size() > 0;
    }

    /// OBSERVÁVEL: é MEMBER ou MANAGER em pelo menos um grupo.
    /// Pode escrever sua própria localização.
    ///
    /// Nota: proprietários (OWNER) e metausuários (METAUSER) NÃO são
    /// observáveis — coerente com as propriedades (a) e (b) da especificação.
    ///
    /// A verificação é system-wide (não per-group) porque a coleção
    /// `usuarios` é flat e não está particionada por grupo.
    function isObservavel() {
      return isAuthenticated()
        && request.auth.token.group_roles is map
        && request.auth.token.group_roles.values().hasAny(["MEMBER", "MANAGER"]);
    }

    /// O email do token corresponde ao ID do documento (coleção `usuarios`).
    function isDocOwner(docEmail) {
      return request.auth.token.email == docEmail;
    }

    /// Verifica se o usuário autenticado tem papel em um grupo específico.
    function hasRoleInGroup(groupEmail) {
      return isAutorizado()
        && groupEmail is string
        && request.auth.token.group_roles[groupEmail] != null;
    }

    /// Verifica se o usuário autenticado é observável (MEMBER ou MANAGER) em um grupo específico.
    function isObservavelInGroup(groupEmail) {
      return isAuthenticated()
        && groupEmail is string
        && request.auth.token.group_roles is map
        && request.auth.token.group_roles[groupEmail] in ["MEMBER", "MANAGER"];
    }

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  COLEÇÃO: usuarios/{email}                                          ║
    // ║                                                                     ║
    // ║  Localização em tempo real. DocId = email do usuário.                ║
    // ║  Campos: email, nome, lat, lng, timestamp, isTracked, grupo_ativo    ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    match /usuarios/{usuarioEmail} {

      // ── LEITURA ─────────────────────────────────────────────────────────
      // O próprio usuário pode ler seu documento OU
      // qualquer usuário autenticado com permissão no grupo_ativo associado.
      allow read: if isDocOwner(usuarioEmail) || (
        isAuthenticated()
        && resource.data.grupo_ativo != null
        && hasRoleInGroup(resource.data.grupo_ativo)
      );

      // ── CRIAÇÃO ─────────────────────────────────────────────────────────
      // Apenas OBSERVÁVEIS podem criar seu próprio documento.
      // A coleção `usuarios` existe exclusivamente para armazenar
      // coordenadas de usuários observáveis.
      allow create: if isObservavel()
        && isDocOwner(usuarioEmail)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(
             ['email', 'nome', 'lat', 'lng', 'timestamp', 'isTracked', 'grupo_ativo']
           )
        && (
          !('grupo_ativo' in request.resource.data)
          || request.resource.data.grupo_ativo == null
          || isObservavelInGroup(request.resource.data.grupo_ativo)
        );

      // ── ATUALIZAÇÃO ─────────────────────────────────────────────────────
      // Um OBSERVÁVEL pode atualizar APENAS seu próprio documento.
      // Se grupo_ativo for fornecido, deve pertencer a um grupo onde é MEMBER ou MANAGER.
      allow update: if isObservavel()
        && isDocOwner(usuarioEmail)
        && request.resource.data.email == resource.data.email
        && request.resource.data.keys().hasOnly(
             ['email', 'nome', 'lat', 'lng', 'timestamp', 'isTracked', 'grupo_ativo']
           )
        && (
          !('grupo_ativo' in request.resource.data)
          || request.resource.data.grupo_ativo == null
          || isObservavelInGroup(request.resource.data.grupo_ativo)
        );

      // ── EXCLUSÃO ────────────────────────────────────────────────────────
      // Exclusão de documentos em `usuarios` é proibida.
      // Dados de localização devem ser preservados.
      allow delete: if false;

      // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
      // SUBCOLEÇÃO: historico_posicoes/{pontoId}
      //
      // Pontos GPS históricos (append-only). Escritos pelo foreground
      // service em updateLocationAndTimestamp().
      // Campos: lat, lng, timestamp, grupo_ativo
      // ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

      match /historico_posicoes/{pontoId} {

        // Leitura permitida ao dono OU a quem possuir papel no grupo_ativo do usuário
        allow read: if isDocOwner(usuarioEmail) || (
          isAuthenticated()
          && hasRoleInGroup(
               get(/databases/$(database)/documents/usuarios/$(usuarioEmail)).data.grupo_ativo
             )
        );

        // Apenas o próprio observável pode criar pontos no SEU histórico.
        allow create: if isObservavel()
          && isDocOwner(usuarioEmail)
          && request.resource.data.keys().hasOnly(['lat', 'lng', 'timestamp', 'grupo_ativo'])
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.timestamp is timestamp;

        // Histórico é imutável (append-only): não permite update nem delete.
        allow update, delete: if false;
      }
    }

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  COLEÇÃO: users/{uid}                                               ║
    // ║                                                                     ║
    // ║  Perfil Google do usuário (criado no login).                         ║
    // ║  DocId = Firebase Auth UID.                                         ║
    // ║  Campos: name, email, urlImage, createdAt, avatarBase64             ║
    // ╚══════════════════════════════════════════════════════════════════════╝

    match /users/{userId} {

      // Qualquer autenticado pode ler perfis (necessário para exibir
      // nomes e avatares de outros usuários no mapa).
      allow read: if isAuthenticated();

      // O usuário pode criar/atualizar apenas seu próprio perfil.
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'urlImage', 'createdAt', 'avatarBase64']
           );

      // Exclusão de perfis é proibida.
      allow delete: if false;
    }

    // ╔══════════════════════════════════════════════════════════════════════╗
    // ║  DEFAULT: negar tudo que não foi explicitamente permitido            ║
    // ║                                                                     ║
    // ║  NÃO HÁ match /{document=**}. O Firestore nega por padrão.          ║
    // ╚══════════════════════════════════════════════════════════════════════╝
  }
}
