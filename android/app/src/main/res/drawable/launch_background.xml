<?xml version="1.0" encoding="utf-8"?>
<!-- Splash shown while the app starts. The background is the partner's
     colors.secondary (partners/<id>/partner.json, set by Gradle as
     @color/splash_background); the image is
     partners/<id>/android/res/drawable/launch_image.png. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_image" />
    </item>
</layer-list>
