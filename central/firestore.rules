rules_version = '2';

// Central MonAmie project. The organization registry organizations/{id} (its `status`
// lifecycle) and retiredOrganizationIds/{id} (ids that can never be used again)
// are read and written only by the central functions through the Admin SDK,
// and by `dart run tool/organization.dart activate` with maintainer credentials.
// The theme catalog themes/{id} is public: names and colors only, read by
// the app (even before an organization is bound) and by the organization projects'
// functions that validate a themeId. It is written only by
// `dart run tool/organization.dart themes`.
// The person-related documents are server-only too, read and written by the
// central functions through the Admin SDK: accounts/{personKey} (the index
// of each person's organizations that resolveOrganizations reads; the app
// never reads it), invites/{id} (with groupId, groupName and the roles) and
// accountDeletions/{personKey}. `tool/organization.dart add-admin` also
// writes accounts/{personKey}, with maintainer credentials.
// No client writes Firestore here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /themes/{themeId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
