rules_version = '2';

// Central MonAmie project. Its only collection, partners/{id} (the partner
// registry), is read by the resolvePartners function through the Admin SDK
// and written by `dart run tool/partner.dart activate`. No client reads or
// writes Firestore here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
